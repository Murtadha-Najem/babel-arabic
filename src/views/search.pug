doctype html
html(lang="ar", dir="rtl")
    include includes/head.pug
    +seo("ابحث في المكتبة", "أي نص يخطر ببالك مكتوب سلفا في مكان ما داخل المكتبة. اكتبه هنا وستعرف أين هو.")

    body(data-page="search")
        include includes/nav.pug

        main
            div(style="margin-bottom: 20px;")
                div.SearchGrid
                    img(src="image/mucha-2.png", alt="رجل بعباءة ذات قلنسوة يقرأ كتابا، بأسلوب الحفر على الخشب")

                    div.BodyStyle
                        p.initial
                            span أي نص
                            |
                            | يخطر ببالك مكتوب سلفا بالحبر، في مكان ما بين الأروقة السداسية لهذه المكتبة. كل ما عليك هو أن تبحث عنه:
                        p
                            em اسمك، وتاريخ ميلادك.
                        p
                            em بيت شعر تحفظه منذ الطفولة.
                        p
                            em رسالة لم ترسلها قط.
                        p
                            em الفصل الأول من رواية لم تُكتب بعد.
                        p
                            em وصف دقيق لما سيحدث غدا، وألف وصف كاذب له.

            form.SearchForm
                textarea(name="content", rows=10, required=true, placeholder="اكتب حتى ١٬٣١٢٬٠٠٠ حرف. الحروف المقبولة: الحروف العربية الثمانية والعشرون، والهمزات، والتاء المربوطة، والألف المقصورة، والفاصلة، والنقطة، وعلامتا الاستفهام والتعجب، والشرطة، والمسافة. التشكيل يُحذف تلقائيا.")
                div.ModeSelection
                    label
                        input(type="radio", name="mode", value="empty", checked=true)
                        | في صفحة فارغة
                    label
                        input(type="radio", name="mode", value="emptybook")
                        | في كتاب فارغ
                    label
                        input(type="radio", name="mode", value="chars")
                        | بين حروف عشوائية
                    label
                        input(type="radio", name="mode", value="words")
                        | بين كلمات عربية عشوائية
                p.Status(aria-live="polite")
                button ابحث

        include includes/footer.pug

    script(type="module", src=`js/app.js?v=${assetVersion}`)
