doctype html
html(lang="ar", dir="rtl")
    include includes/head.pug
    +seo("تصفح المكتبة", "اذهب إلى غرفة وجدار ورف وكتاب وصفحة بعينها داخل المكتبة.")

    body(data-page="browse")
        include includes/nav.pug

        main
            img.Banner(src="image/shelves.png", alt="رسم بالقلم لرجل بعباءة يقف قرب رفوف كتب عالية")

            form#browse.BrowseForm
                label
                    p الغرفة
                    textarea(name="room", rows=2, required=true, placeholder="رمز الغرفة: أرقام من 0 إلى 9 وحروف لاتينية من a إلى v")

                div.Numbers
                    label
                        p الجدار
                            |
                            |
                            span ١ إلى ٤
                        input(name="wall", type="number", min=1, max=4, value=1, required=true)

                    label
                        p الرف
                            |
                            |
                            span ١ إلى ٥
                        input(name="shelf", type="number", min=1, max=5, value=1, required=true)

                    label
                        p الكتاب
                            |
                            |
                            span ١ إلى ٣٢
                        input(name="book", type="number", min=1, max=32, value=1, required=true)

                    label
                        p الصفحة
                            |
                            |
                            span ١ إلى ٤١٠
                        input(name="page", type="number", min=1, max=410, value=1, required=true)

                button اذهب

            div.Divider
                p أو

            form#bookmark.BrowseForm
                label
                    p ارفع ملف علامة صفحة
                        |
                        |
                        span تنزّله من أي صفحة تقرؤها
                    input(type="file", name="bookmark", accept=".babel", multiple=false, required=true)

                Button اذهب

        include includes/footer.pug

    script(type="module", src=`js/app.js?v=${assetVersion}`)
