doctype html
html(lang="ar", dir="rtl")
    include includes/head.pug
    +seo("تصفح المكتبة")

    //- src/web/app.ts computes the page named in the URL fragment and fills this in
    body(data-page="page")
        include includes/nav.pug

        main
            div.PageInfo
                p الغرفة ... / الجدار ... / الرف ... / الكتاب ... / الصفحة ...
                a.nobreak.FullAddress(href="#") نزّل العنوان الكامل

            div.PageActions
                button.Button.HighlightWords(type="button") ظلّل الكلمات العربية
                button.Button.DownloadBookmark(type="button") نزّل علامة الصفحة
                button.Button.DownloadPdf(type="button") نزّل الكتاب كاملا (PDF)

            p.PageStatus(aria-live="polite") لحظة، المكتبة تحسب هذه الصفحة...

            div.PageContentWrapper
                div.PageContent
                    div.Lines
                        - let n = 1
                        while n <= 40
                            span= n < 10 ? `0${n}` : n
                            - n++
                    pre.Loading

            div.PageNavigation
                a.Prev(href="#") &rarr; السابقة

                div.PageSelector
                    p الصفحة
                    - let p = 1
                    select
                        while p <= 410
                            option(value=p)= p
                            - p++

                a.Next(href="#") التالية &larr;

            p.ShareNote روابط الصفحات التي تصل إليها بالبحث أو عشوائيا تُحفظ في متصفحك وحده، لأن رقم الغرفة أطول من أن يوضع في رابط. لتشاركها مع غيرك نزّل علامة الصفحة أو عنوانها الكامل، ويفتحها من صفحة التصفح.

        include includes/footer.pug

    script(type="module", src=`js/app.js?v=${assetVersion}`)
