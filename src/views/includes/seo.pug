mixin seo(title="تصفح مكتبة بابل", description="نسخة عربية كاملة من مكتبة بابل لبورخيس: كل كتاب يمكن أن يُكتب بالحروف العربية موجود فيها.")
    title
        | #{title} | مكتبة بابل
    meta(name="description", content=description)
    meta(name="og:title", property="og:title", content=`${title} | مكتبة بابل`)
    meta(name="og:description", property="og:description", content=description)
    meta(name="og:site_name", property="og:site_name", content="مكتبة بابل")
    meta(name="og:type", property="og:type", content="website")
