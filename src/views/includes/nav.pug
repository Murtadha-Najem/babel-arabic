- const here = (href) => (typeof path !== "undefined" && path === href ? "page" : undefined)
nav
    h1
        a(href="./") مكتبة بابل
    div.Links
        a(href="search.html", aria-current=here("search")) بحث
        a(href="browse.html", aria-current=here("browse")) تصفح
        a(href="examples.html", aria-current=here("examples")) أمثلة
        a(href="page.html#random") صفحة عشوائية
        a(href="about.html", aria-current=here("about")) عن المكتبة
