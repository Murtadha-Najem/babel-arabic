doctype html
html(lang="ar", dir="rtl")
    include includes/head.pug
    +seo("كيف تعمل المكتبة؟", "مكتبة بابل تحتوي كل كتاب يمكن أن يُكتب بالحروف العربية. كيف يحدث ذلك من غير أن يُخزَّن كتاب واحد؟")

    body
        include includes/nav.pug

        main.BodyStyle
            img.Banner(src="image/study-2.png", alt="رسم بالقلم لرجل بعباءة يقف قرب رفوف كتب عالية")

            h2 ما مكتبة بابل؟
            p.initial
                span مكتبة
                |
                | فيها كل كتاب ممكن طوله ١٬٣١٢٬٠٠٠ حرف: ٤١٠ صفحات، في كل صفحة ٤٠ سطرا، في كل سطر ٨٠ حرفا. ولأن كل حرف واحد من ٤٢ رمزا، فعدد الكتب المختلفة هو
                |
                |
                span.nobreak(dir="ltr") 42
                    span.super 1,312,000
                | ، أي قرابة
                |
                |
                span.nobreak(dir="ltr") 10
                    span.super 2,129,703
                | . وللمقارنة، عدد الذرات في الكون المرئي يقدَّر بنحو
                |
                |
                span.nobreak(dir="ltr") 10
                    span.super 80
                | .

            h2 أين تُخزَّن الكتب؟
            p لا تُخزَّن في أي مكان. الكتاب يُحسب بدالة رياضية لحظة فتحه، ثم يُنسى. كما أن حاصل ضرب ٢ في ٥ لا يحتاج إلى أن يُحفظ في مكان ما حتى يبقى ١٠، يحسب الزائر التالي الدالة نفسها فيحصل على الكتاب نفسه حرفا بحرف.

            h2 كيف تُحسب؟
            ol
                li لكل كتاب رقم تسلسلي. الكتاب الأول على الرف الأول رقمه ١، والكتاب الأول على الرف الثاني رقمه ٣٣، وهكذا حتى آخر كتاب في المكتبة.
                li يُضرب هذا الرقم في عدد ثابت ضخم، ويؤخذ باقي قسمته على عدد ثابت آخر. الناتج رقم جديد من ١٬٣١٢٬٠٠٠ خانة، مكتوب بنظام عد أساسه ٤٢.
                li كل خانة من الناتج تقابل رمزا من الرموز الاثنين والأربعين: الصفر يقابل «ا»، والواحد يقابل «ب»، وهكذا. والنتيجة هي نص الكتاب.
            p هذه العملية قابلة للعكس. إذا أعطيتها نصا حوّلته إلى رقم، ثم ضربته في معكوس العدد الثابت، فخرج رقم الكتاب الذي يحتوي هذا النص. هذا ما يحدث حين تبحث.
            p عنوان كل صفحة مشتق من رقم كتابها، بالصيغة
                |
                |
                span.code(dir="ltr") room.wall.shelf.book.page
                | ، مثل
                |
                span.code(dir="ltr") 1.2.3.4.5
                | .

            h2 كيف أعرف أن البحث لا يزوّر النتيجة؟
            p الظن الأول أن الموقع يأخذ ما كتبته، ويضعه في صفحة عشوائية، ويحفظها لتجدها لاحقا. لكن كتابا واحدا يشغل أكثر من مليون حرف، وحفظ كل الكتب يحتاج إلى مساحة تفوق كل ما في الكون من مادة. لا توجد قاعدة بيانات للكتب هنا أصلا، والشيفرة كلها منشورة ويمكن التحقق منها.

            h2 هل تتطابق مع النسخة الإنكليزية؟
            p لا. هذه مكتبة أخرى بحروف أخرى، فنص بعينه يقع فيها في عنوان مختلف تماما عن عنوانه في
                |
                |
                a(href="https://libraryofbabel.app", target="_blank") النسخة الإنكليزية
                | .

            h2 المصدر
            p أعد هذه النسخة العربية
                |
                |
                a(href="https://github.com/murtadha203", target="_blank") مرتضى نجم
                | ، وبناها على
                |
                a(href="https://github.com/tdjsnelling/babel", target="_blank") مشروع #[bdi Tom Snelling]
                | ، وهي منشورة بالرخصة نفسها (GPL-3.0).

        include includes/footer.pug
